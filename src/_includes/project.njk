---
layout: base.njk
---
<main id="main" class="reel-page">
<div class="reel-shell" data-reel-shell>
  <div class="reel reel--project" data-reel aria-label="{{ title }}图片，横向拖动观看">
    <div class="reel-track">
      {% for image in gallery %}
      <figure class="slide slide--project{{ ' ' + image.class if image.class else '' }}">
        <a href="{{ image.src }}" data-lightbox="{{ page.fileSlug }}" data-caption="{{ image.caption }}">
          <img src="{{ image.src }}" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}" loading="{{ 'eager' if loop.index <= 2 else 'lazy' }}" decoding="async">
        </a>
        <figcaption><span>{{ image.caption }}</span></figcaption>
      </figure>
      {% endfor %}
      <article class="project-end" id="project-text" tabindex="0" aria-label="项目说明">
        <div class="notes">{{ content | safe }}</div>
      </article>
    </div>
  </div>
  <div class="reel-ui">
    <div class="reel-progress"><span data-progress></span></div>
    <div class="reel-buttons"><button type="button" data-prev aria-label="上一张">←</button><button type="button" data-next aria-label="下一张">→</button></div>
  </div>
</div>
</main>
