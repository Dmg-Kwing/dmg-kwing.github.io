<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<script>document.documentElement.classList.add("js");</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle or title or "INDEX" }}</title>
<meta name="description" content="{{ description or '' }}">
<link rel="stylesheet" href="/assets/style.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<noscript><style>.intro{display:none!important}</style></noscript>
</head>
<body class="{{ bodyClass or '' }}">
<a class="skip" href="#main">跳到正文</a>
{% if intro %}
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro-frame">
    <img class="intro-img" src="{{ introImage or '/imgs/drawings/d13.webp' }}" alt="" width="{{ introWidth or 2000 }}" height="{{ introHeight or 1055 }}" fetchpriority="high">
    <span class="intro-wash"></span>
  </div>
</div>
{% endif %}
{% include "rail.njk" %}
{{ content | safe }}
{% if footer %}
<footer class="page-foot">
  <span>© <span data-year>2026</span> · INDEX</span>
  <span><a href="/">HOME</a></span>
</footer>
{% endif %}
<script src="/assets/site.js"></script>
</body>
</html>
