---
layout: base.njk
---
<main id="main" class="reel-page reel-page--bare">
<div class="reel-shell" data-reel-shell>
  <div class="reel reel--games" data-reel aria-label="最近在玩，横向拖动观看">
    <div class="reel-track">
      {% for game in games %}
      <figure class="slide slide--game">
        <a class="game-card" href="{{ game.link }}" target="_blank" rel="noopener">
          <span class="game-cover"><img src="{{ game.image }}" alt="{{ game.alt }}" width="920" height="430" loading="lazy" decoding="async"></span>
          <span class="game-meta"><span><span class="game-name">{{ game.title }}</span><span class="game-note">{{ game.note }}</span></span><span class="game-hours">{{ game.hours }}<small>hours</small></span></span>
        </a>
      </figure>
      {% endfor %}
      <div class="reel-end">
        <p class="big-count">{{ total }}</p>
        <p>{{ endNote }}</p>
        <a class="text-link" href="{{ steamUrl }}" target="_blank" rel="noopener">{{ steamText }}</a>
      </div>
    </div>
  </div>
  <div class="reel-ui">
    <div class="reel-progress"><span data-progress></span></div>
    <div class="reel-buttons"><button type="button" data-prev aria-label="上一张">←</button><button type="button" data-next aria-label="下一张">→</button></div>
  </div>
</div>
</main>
